# FairGuard AI - Environment Configuration Example
# Copy this file to .env and customize for local or production use (never commit .env).

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://fairguard:fairguard_secret@localhost:5432/fairguard
# For standalone local SQLite:
# DATABASE_URL=sqlite:///artifacts/fairguard.db

# REST API Endpoint
API_URL=http://127.0.0.1:8000

# MLflow Tracking Server URI
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Streamlit Port Configuration
STREAMLIT_SERVER_PORT=8501

# Sampling Flag (set to 1 for fast dev runs, unset for full dataset evaluation)
FAIRGUARD_SAMPLE=1
